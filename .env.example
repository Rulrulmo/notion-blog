# Notion integration 토큰과 블로그 DB ID
NOTION_TOKEN=
NOTION_DATABASE_ID=

# 웹에 공개된 Notion 사이트 주소 (커버 이미지 프록시용), 예: https://rulmo.notion.site
NEXT_PUBLIC_NOTION_SITE_URL=

# 배포 주소 (sitemap, robots, OG 이미지 절대경로), 예: https://rulmo.vercel.app
NEXT_PUBLIC_URL=

# Supabase (조회수)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
